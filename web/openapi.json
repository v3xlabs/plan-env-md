    "/api/auth/register": {
      "post": {
        "summary": "Create an account. The first account needs no invite code and becomes\nadmin; every later one consumes an unused invite code.",
        "requestBody": {
          "content": {
            "application/json; charset=utf-8": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/UserBody"
                }
              }
            }
          },
          "422": {
            "description": "Username or password does not meet the requirements",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Invite code missing, unknown, or already used"
          },
          "409": {
            "description": "Username already taken"
          },
          "429": {
            "description": "Too many attempts from this address; try again later"
          }
        }
      }
    },
    "/api/auth/login": {
