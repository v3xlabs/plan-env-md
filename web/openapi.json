    "/api/projects/{project}/aliases/{alias}": {
      "put": {
        "summary": "Point another name at this project. A push naming the alias lands in the\nproject, so `openlv` and `open-lavatory` do not become two piles.",
        "parameters": [
          {
            "name": "project",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "alias",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "409": {
            "description": "The alias is already a project of its own, or points somewhere else",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Not a valid slug shape",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          },
          {
            "SessionAuth": []
          }
        ]
      },
      "delete": {
        "summary": "Stop resolving this name. Documents already in the project stay put.",
        "parameters": [
          {
            "name": "project",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "alias",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          }
        ],
        "responses": {
          "204": {
            "description": ""
