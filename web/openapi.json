    "/api/docs/{slug}/answers/{key}": {
      "put": {
        "summary": "Record one answer. Accepts a browser session or a scoped answer key,\nnever a normal API token.",
        "parameters": [
          {
            "name": "slug",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "key",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json; charset=utf-8": {
              "schema": {
                "$ref": "#/components/schemas/AnswerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/Answer"
                }
              }
            },
            "headers": {
              "ACCESS-CONTROL-ALLOW-ORIGIN": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "The answer does not fit the question that was asked",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "ACCESS-CONTROL-ALLOW-ORIGIN": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No such document, or the latest revision does not ask this question",
            "headers": {
              "ACCESS-CONTROL-ALLOW-ORIGIN": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Withdraw an answer, returning the question to unanswered.",
        "parameters": [
          {
            "name": "slug",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "key",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          }
        ],
        "responses": {
          "204": {
            "description": "",
            "headers": {
              "ACCESS-CONTROL-ALLOW-ORIGIN": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "",
            "headers": {
              "ACCESS-CONTROL-ALLOW-ORIGIN": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "options": {
        "summary": "CORS preflight for the two answer routes. The widget calls from the\ndocument's opaque origin, which presents `Origin: null`.",
        "parameters": [
          {
            "name": "_slug",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "_key",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          }
        ],
        "responses": {
          "204": {
            "description": "",
            "headers": {
              "ACCESS-CONTROL-ALLOW-ORIGIN": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              },
              "ACCESS-CONTROL-ALLOW-HEADERS": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              },
              "ACCESS-CONTROL-ALLOW-METHODS": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              },
              "ACCESS-CONTROL-MAX-AGE": {
                "required": true,
