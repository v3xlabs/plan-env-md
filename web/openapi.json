{
  "openapi": "3.0.0",
  "info": {
    "title": "plan-env-md",
    "version": "0.1.0"
  },
  "servers": [],
  "tags": [],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Create an account. The first account needs no invite code and becomes\nadmin; every later one consumes an unused invite code.",
        "requestBody": {
          "content": {
            "application/json; charset=utf-8": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/UserBody"
                }
              }
            }
          },
          "422": {
            "description": "Username or password does not meet the requirements",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Invite code missing, unknown, or already used"
          },
          "409": {
            "description": "Username already taken"
          },
          "429": {
            "description": "Too many attempts from this address; try again later"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Log in with username and password.",
        "requestBody": {
          "content": {
            "application/json; charset=utf-8": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/UserBody"
                }
              }
            }
          },
          "401": {
            "description": "Unknown username or wrong password"
          },
          "429": {
            "description": "Too many attempts from this address; try again later"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "End the current session.",
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "The authenticated account.",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/UserBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          },
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/tokens": {
      "get": {
        "summary": "List API tokens. Only the display prefix is available after creation.",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TokenBody"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      },
      "post": {
        "summary": "Create an API token for an agent.",
        "requestBody": {
          "content": {
            "application/json; charset=utf-8": {
              "schema": {
                "$ref": "#/components/schemas/CreateTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedTokenBody"
                }
              }
            }
          },
          "422": {
            "description": "Name is empty",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/tokens/{id}": {
      "delete": {
        "summary": "Revoke an API token.",
        "parameters": [
          {
            "name": "id",
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": "No token with this id on this account"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/invites": {
      "get": {
        "summary": "List invite codes and who used them.",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InviteBody"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Admin only"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      },
      "post": {
        "summary": "Mint an invite code.",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/InviteBody"
                }
              }
            }
          },
          "403": {
            "description": "Admin only"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/invites/{id}": {
      "delete": {
        "summary": "Delete an unused invite code.",
        "parameters": [
          {
            "name": "id",
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "403": {
            "description": "Admin only"
          },
          "404": {
            "description": "No unused invite with this id"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/docs/{slug}": {
      "put": {
        "summary": "Push a document. The first push of a slug creates the document and\nmints its public id; every later push appends a revision at the same\nURL.",
        "parameters": [
          {
            "name": "slug",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "title",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "required": false,
            "deprecated": false,
            "explode": true
          }
        ],
        "requestBody": {
          "content": {
            "text/html": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/PushedBody"
                }
              }
            }
          },
          "422": {
            "description": "Slug must match [a-z0-9-]{1,64}",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          },
          {
            "SessionAuth": []
          }
        ]
      },
      "get": {
        "summary": "Document metadata and its revision index.",
        "parameters": [
          {
            "name": "slug",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDetailBody"
                }
              }
            }
          },
          "404": {
            "description": "No document with this slug on this account"
          }
        },
        "security": [
          {
            "BearerAuth": []
          },
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/docs": {
      "get": {
        "summary": "List your documents.",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DocumentBody"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          },
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/docs/{slug}/raw": {
      "get": {
        "summary": "The latest revision's HTML.",
        "parameters": [
          {
            "name": "slug",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "text/html; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "CONTENT-SECURITY-POLICY": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              },
              "X-CONTENT-TYPE-OPTIONS": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              },
              "REFERRER-POLICY": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No such document or revision on this account"
          }
        },
        "security": [
          {
            "BearerAuth": []
          },
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/docs/{slug}/revisions/{revision}/raw": {
      "get": {
        "summary": "The HTML as of a specific revision.",
        "parameters": [
          {
            "name": "slug",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "revision",
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "text/html; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "CONTENT-SECURITY-POLICY": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              },
              "X-CONTENT-TYPE-OPTIONS": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              },
              "REFERRER-POLICY": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No such document or revision on this account"
          }
        },
        "security": [
          {
            "BearerAuth": []
          },
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/docs/{slug}/publish": {
      "post": {
        "summary": "Publish the document behind a password. Calling this again rotates the\npassword and invalidates every outstanding visitor cookie.",
        "parameters": [
          {
            "name": "slug",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json; charset=utf-8": {
              "schema": {
                "$ref": "#/components/schemas/PublishRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedBody"
                }
              }
            }
          },
          "422": {
            "description": "Password must not be empty",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No document with this slug on this account"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    },
    "/api/docs/{slug}/unpublish": {
      "post": {
        "summary": "Take the document off the public URL again.",
        "parameters": [
          {
            "name": "slug",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": "No document with this slug on this account"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateTokenRequest": {
        "type": "object",
        "title": "CreateTokenRequest",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreatedTokenBody": {
        "type": "object",
        "title": "CreatedTokenBody",
        "required": [
          "id",
          "name",
          "token"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "token": {
            "type": "string",
            "description": "The full token. Shown exactly once; only its hash is stored."
          }
        }
      },
      "DocumentBody": {
        "type": "object",
        "title": "DocumentBody",
        "required": [
          "id",
          "slug",
          "published",
          "revision_count",
          "latest_revision",
          "last_pushed_at",
          "created_at",
          "updated_at",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "published": {
            "type": "boolean"
          },
          "revision_count": {
            "type": "integer",
            "format": "int64"
          },
          "latest_revision": {
            "type": "integer",
            "format": "int64"
          },
          "last_pushed_at": {
            "type": "string",
            "description": "When the newest revision was pushed; the list sorts by this"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "DocumentDetailBody": {
        "type": "object",
        "title": "DocumentDetailBody",
        "required": [
          "id",
          "slug",
          "published",
          "created_at",
          "updated_at",
          "url",
          "revisions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "published": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "revisions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RevisionBody"
            }
          }
        }
      },
      "InviteBody": {
        "type": "object",
        "title": "InviteBody",
        "required": [
          "id",
          "code",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "code": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "used_at": {
            "type": "string"
          },
          "used_by": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "title": "LoginRequest",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "PublishRequest": {
        "type": "object",
        "title": "PublishRequest",
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          }
        }
      },
      "PublishedBody": {
        "type": "object",
        "title": "PublishedBody",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          }
        }
      },
      "PushedBody": {
        "type": "object",
        "title": "PushedBody",
        "required": [
          "id",
          "slug",
          "revision",
          "size_bytes",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Server-minted public document id, stable across revisions"
          },
          "slug": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "title": "RegisterRequest",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "invite_code": {
            "type": "string"
          }
        }
      },
      "RevisionBody": {
        "type": "object",
        "title": "RevisionBody",
        "required": [
          "revision",
          "size_bytes",
          "created_at"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "created_at": {
            "type": "string"
          }
        }
      },
      "TokenBody": {
        "type": "object",
        "title": "TokenBody",
        "required": [
          "id",
          "name",
          "token_prefix",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "token_prefix": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "last_used_at": {
            "type": "string"
          }
        }
      },
      "UserBody": {
        "type": "object",
        "title": "UserBody",
        "required": [
          "id",
          "username",
          "is_admin"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "is_admin": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "description": "Bearer PAT, for agents.",
        "scheme": "bearer"
      },
      "SessionAuth": {
        "type": "apiKey",
        "description": "Session cookie, for the management UI.",
        "name": "session",
        "in": "cookie"
      }
    }
  }
}
